{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "v1",
      "kind": "Namespace",
      "metadata": {
        "name": "tgm-one-staging"
      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "tgm-one-staging",
        "namespace": "tgm-one-staging",
        "labels": {
          "app": "tgm-one-staging"
        }
      },
      "spec": {
        "progressDeadlineSeconds": 600,
        "replicas": 1,
        "revisionHistoryLimit": 10,
        "selector": {
          "matchLabels": {
            "app": "tgm-one-staging"
          }
        },
        "strategy": {
          "rollingUpdate": {
            "maxSurge": "25%",
            "maxUnavailable": "25%"
          },
          "type": "RollingUpdate"
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "tgm-one-staging"
            }
          },
          "spec": {
            "containers": [
              {
                "env": [
                  {
                    "name": "FOLIGO_BASE_URL",
                    "value": "https://api.foligo.org"
                  },
                  {
                    "name": "FOLIGO_PROJECT_ID",
                    "value": "e9f40961-f0db-42f1-8269-8084906a2828"
                  },
                  {
                    "name": "FOLIGO_SUBDOMAIN",
                    "value": "aiden"
                  }
                ],
                "image": "registry.tgm.one/tgm.one/tgm-one-stage:latest",
                "imagePullPolicy": "Always",
                "livenessProbe": {
                  "failureThreshold": 3,
                  "httpGet": {
                    "path": "/",
                    "port": 3000,
                    "scheme": "HTTP"
                  },
                  "initialDelaySeconds": 15,
                  "periodSeconds": 30,
                  "successThreshold": 1,
                  "timeoutSeconds": 1
                },
                "name": "website",
                "ports": [
                  {
                    "containerPort": 3000,
                    "name": "web",
                    "protocol": "TCP"
                  }
                ],
                "readinessProbe": {
                  "failureThreshold": 3,
                  "httpGet": {
                    "path": "/",
                    "port": 3000,
                    "scheme": "HTTP"
                  },
                  "initialDelaySeconds": 5,
                  "periodSeconds": 10,
                  "successThreshold": 1,
                  "timeoutSeconds": 1
                },
                "resources": {
                  "limits": {
                    "cpu": "500m",
                    "memory": "512Mi"
                  },
                  "requests": {
                    "cpu": "50m",
                    "memory": "128Mi"
                  }
                },
                "terminationMessagePath": "/dev/termination-log",
                "terminationMessagePolicy": "File"
              }
            ],
            "dnsPolicy": "ClusterFirst",
            "imagePullSecrets": [
              {
                "name": "registry-tgm-one"
              }
            ],
            "restartPolicy": "Always",
            "schedulerName": "default-scheduler",
            "securityContext": {},
            "terminationGracePeriodSeconds": 30
          }
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "tgm-one-staging",
        "namespace": "tgm-one-staging"
      },
      "spec": {
        "selector": {
          "app": "tgm-one-staging"
        },
        "ports": [
          {
            "name": "http",
            "port": 80,
            "targetPort": 3000
          }
        ]
      }
    },
    {
      "apiVersion": "networking.k8s.io/v1",
      "kind": "Ingress",
      "metadata": {
        "name": "tgm-one-staging",
        "namespace": "tgm-one-staging",
        "annotations": {
          "cert-manager.io/cluster-issuer": "letsencrypt-cloudflare",
          "external-dns.alpha.kubernetes.io/cloudflare-proxied": "false",
          "nginx.ingress.kubernetes.io/ssl-redirect": "true"
        }
      },
      "spec": {
        "ingressClassName": "nginx",
        "tls": [
          {
            "hosts": [
              "staging.tgm.one"
            ],
            "secretName": "staging-tgm-one-tls"
          }
        ],
        "rules": [
          {
            "host": "staging.tgm.one",
            "http": {
              "paths": [
                {
                  "path": "/",
                  "pathType": "Prefix",
                  "backend": {
                    "service": {
                      "name": "tgm-one-staging",
                      "port": {
                        "number": 80
                      }
                    }
                  }
                }
              ]
            }
          }
        ]
      }
    }
  ]
}
